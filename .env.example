# 以太坊主网归档 RPC，用于历史状态读取；仅在本机 .env 填写真实地址。
ETH_RPC_URL=
# 原指定 rpcfree 端点，仅用于连通性和归档能力复核。
RPCFREE_RPC_URL=
# 已获授权的候选以太坊 RPC 1，用于最小历史日志诊断。
CANDIDATE_RPC_1=
# 已获授权的候选以太坊 RPC 2，用于最小历史日志诊断。
CANDIDATE_RPC_2=
# 已获授权的候选以太坊 RPC 3，用于最小历史日志诊断。
CANDIDATE_RPC_3=
# 后续部署使用的私钥；Phase 0 不读取、不使用，当前留空。
PRIVATE_KEY=
# 后续语言模型服务的 API 密钥；Phase 0 不使用，当前留空。
LLM_API_KEY=

# BOT Chain 主网 RPC；仅用于链 ID 677 的预检与经确认后的部署，绝不与以太坊 RPC 混用。
BOT_RPC_URL=
# BOT Chain 主网链 ID，预期为 677。
BOT_CHAIN_ID=
# BOT Chain 主网区块浏览器根地址，用于部署后源码验证。
BOT_EXPLORER_URL=
# BOT Chain 部署私钥；仅在本机填写，不得提交或输出，同一地址用于测试网彩排。
BOT_PRIVATE_KEY=
# 语言模型兼容接口的基础地址。
LLM_BASE_URL=
# 语言模型名称。
LLM_MODEL=
# BOT Chain 测试网 RPC；只用于测试网彩排，绝不与主网 RPC 混用。
BOT_TESTNET_RPC_URL=
# BOT Chain 测试网链 ID，预期为 968。
BOT_TESTNET_CHAIN_ID=
# BOT Chain 测试网区块浏览器根地址。
BOT_TESTNET_EXPLORER_URL=
